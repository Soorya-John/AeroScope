# Local-only HTTP server. Remote binding is blocked until authentication is implemented.
AEROSCOPE_HOST=127.0.0.1
AEROSCOPE_PORT=8765

# Optional local data directory; defaults to ./data
# AEROSCOPE_DATA_DIR=C:/Users/you/AppData/Local/AeroScope

# Maximum uploaded flight-log size in MiB (default: 128)
AEROSCOPE_MAX_UPLOAD_MB=128

# Optional user-configured MapLibre-compatible style URL. Not bundled with the app.
# Do not put credentials or API tokens here; the current map is an offline coordinate plot.
# AEROSCOPE_MAP_STYLE_URL=
